# NeoMutt config — account details live in account.muttrc (gitignored).
# Copy account.muttrc.example -> account.muttrc and fill it in.

source ~/.config/neomutt/account.muttrc

# Catppuccin flavour from ~/.config/theme (dark=mocha, light=latte), same as tmux
source "~/.config/neomutt/colors/catppuccin-`grep -qx light ~/.config/theme 2>/dev/null && echo latte || echo mocha`.muttrc"

# --- IMAP behaviour ---
set imap_check_subscribed = yes      # list subscribed folders as mailboxes
set imap_keepalive = 300
set mail_check = 60
set timeout = 15
unset imap_passive                   # allow opening new IMAP connections for mail checks
set ssl_force_tls = yes

# --- Local caches (headers + bodies) for speed ---
set header_cache = ~/.cache/neomutt/headers
set message_cachedir = ~/.cache/neomutt/bodies
set certificate_file = ~/.cache/neomutt/certificates

# --- Composing ---
set editor = "nvim"
set edit_headers = yes
set fast_reply = yes
set include = yes
set reverse_name = yes
set forward_format = "Fwd: %s"
set send_charset = "utf-8"

# --- Index / pager ---
set sort = threads
set sort_aux = reverse-last-date-received
set use_threads = reverse
set date_format = "%Y-%m-%d %H:%M"
set index_format = "%4C %Z %D %-20.20F %s"
set pager_index_lines = 10
set pager_context = 3
set pager_stop = yes
set menu_scroll = yes
set markers = no
set mime_forward = yes
set sidebar_visible = yes
set sidebar_width = 28
set sidebar_short_path = yes
set sidebar_folder_indent = yes
set mail_check_stats = yes
set sidebar_format = "%B%* %?N?%N/?%S"
auto_view text/html
alternative_order text/plain text/enriched text/html

# --- Vim-ish keys ---
bind index,pager g noop
bind index gg first-entry
bind index G last-entry
bind pager gg top
bind pager G bottom
bind index,pager \Ck sidebar-prev
bind index,pager \Cj sidebar-next
bind index,pager \Co sidebar-open
bind index,pager B sidebar-toggle-visible
bind index,pager \Cu half-up
bind index,pager \Cd half-down
macro index,pager gi "<change-folder>=INBOX<enter>" "go to inbox"
